@model InternTracker.Models.UploadProfilePictureViewModel

@{
    ViewData["Title"] = "Upload Profile Picture";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h2 class="card-title text-center fw-bold mb-4">@ViewData["Title"]</h2>
                    <form asp-action="UploadProfilePicture" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-4">
                            <label asp-for="ProfilePicture" class="form-label"></label>
                            <input asp-for="ProfilePicture" type="file" class="form-control" />
                            <span asp-validation-for="ProfilePicture" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Upload</button>
                            <a asp-action="Index" class="btn btn-outline-dark">Back to Profile</a>
                        </div>

                        @if (ViewBag.Message != null)
                        {
                            <div class="alert alert-success mt-3 text-center">@ViewBag.Message</div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
