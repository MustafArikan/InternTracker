@model InternTracker.Models.AppUser

@{
    ViewData["Title"] = "Profile";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="card-title text-center fw-bold mb-4">Your Profile</h2>

                    <div class="text-center mb-4">
                        <img src="@(string.IsNullOrWhiteSpace(Model.ProfilePicturePath) ? Url.Content("~/images/default-avatar.png") : Url.Content(Model.ProfilePicturePath))"
                             alt="Profile Picture"
                             class="img-fluid rounded-circle mb-3"
                             style="width: 120px; height: 120px; object-fit: cover; border: 3px solid var(--bs-primary);" />
                        <h3>@Model.Username</h3>
                        <p class="text-muted">@Model.Role</p>
                    </div>

                    <hr class="my-4">

                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Email:</div>
                        <div class="col-sm-8">@Html.DisplayFor(model => model.Email)</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Registration Date:</div>
                        <div class="col-sm-8">@Html.DisplayFor(model => model.RegistrationDate)</div>
                    </div>

                    <hr class="my-4">

                    <div class="d-grid gap-2">
                        <a asp-action="ChangeUsername" class="btn btn-outline-secondary btn-lg">
                            <i class="fas fa-user-edit me-2"></i>Change Username
                        </a>
                        <a asp-action="UploadProfilePicture" class="btn btn-outline-secondary btn-lg">
                            <i class="fas fa-image me-2"></i>Upload Profile Picture
                        </a>
                        <a asp-action="UpdateEmail" class="btn btn-outline-secondary btn-lg">
                            <i class="fas fa-envelope me-2"></i>Update Email
                        </a>
                        <a asp-action="ChangePassword" class="btn btn-outline-secondary btn-lg">
                            <i class="fas fa-key me-2"></i>Change Password
                        </a>
                        <a asp-action="DeleteAccount" class="btn btn-outline-danger btn-lg mt-3">
                            <i class="fas fa-user-slash me-2"></i>Delete Account
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
