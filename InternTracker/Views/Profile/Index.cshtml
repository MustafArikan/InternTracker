@model InternTracker.Models.AppUser

@{ 
    ViewData["Title"] = "Profile";
}

<h1>Profile</h1>

<div>
    <h4>User Profile</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Username
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Username)
        </dd>
        <dt class="col-sm-2">
            Email
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class="col-sm-2">
            Role
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Role)
        </dd>
        <dt class="col-sm-2">
            Profile Picture
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
            {
                <img src="@Model.ProfilePicturePath" alt="Profile Picture" width="100" height="100" />
            }
            else
            {
                <span>No profile picture uploaded.</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="ChangePassword">Change Password</a> |
    <a asp-action="UpdateEmail">Update Email</a> |
    <a asp-action="UploadProfilePicture">Upload Profile Picture</a>
</div>
