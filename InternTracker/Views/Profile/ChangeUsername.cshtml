@model InternTracker.Models.ChangeUsernameViewModel

@{
    ViewData["Title"] = "Change Username";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h2 class="card-title text-center fw-bold mb-4">@ViewData["Title"]</h2>
                    <form asp-action="ChangeUsername">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="CurrentUsername" class="form-label">Current Username</label>
                            <input asp-for="CurrentUsername" class="form-control" readonly />
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="NewUsername" class="form-control" placeholder="New Username" />
                            <label asp-for="NewUsername">New Username</label>
                            <span asp-validation-for="NewUsername" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Change Username</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Back to Profile</a>
                        </div>

                        @if (ViewBag.Message != null)
                        {
                            <div class="alert alert-success mt-3 text-center">@ViewBag.Message</div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
