@model IEnumerable<InternTracker.Models.TaskItem>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "My Tasks";
    Layout = "_Layout";
    var activeWorkSessionId = HttpContextAccessor.HttpContext.Session.GetInt32("ActiveWorkSessionId");
    var activeTaskId = HttpContextAccessor.HttpContext.Session.GetInt32("ActiveTaskId");
    var username = HttpContextAccessor.HttpContext.Session.GetString("Username");
}

@section Styles {
    <style>
        .stat-card {
            border-left: 5px solid var(--bs-primary);
            transition: all 0.2s ease-in-out;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                border-left-width: 7px;
            }

        .nav-card {
            text-decoration: none;
            color: inherit;
            display: block;
            transition: all 0.3s ease-in-out;
        }

            .nav-card:hover {
                transform: scale(1.03);
                box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
            }

            .nav-card .card-body {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 150px;
            }

        .nav-card-icon {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            color: var(--bs-primary);
        }

        .status-badge {
            font-size: 0.9rem;
            padding: 0.5em 0.8em;
        }

        .timer {
            font-weight: bold;
            color: var(--bs-primary);
        }
    </style>
}

<div class="container py-5">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="display-5 fw-bold">@ViewData["Title"]</h1>
            <p class="text-muted">Here are your assigned tasks. Stay organized and track your progress.</p>
        </div>
        <div class="col-auto">
            <a asp-action="LogWorkSession" class="btn btn-primary fw-bold">
                <i class="fas fa-clock me-2"></i>Log Work Session
            </a>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm nav-card">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-tasks fa-2x text-primary me-3"></i>
                                <div>
                                    <h5 class="card-title mb-0">@item.Title</h5>
                                    <small class="text-muted">Assigned: @item.AssignedDate.ToString("MMM dd, yyyy")</small>
                                    <p class="card-text">@item.Description</p>
                                </div>
                            </div>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span id="status-@item.Id" class="badge rounded-pill status-badge
                                      @if (item.Status == InternTracker.Models.TaskStatus.Completed)
                                    {
                                          <text>bg-success</text>
                                      }
                                            else if (item.Status == InternTracker.Models.TaskStatus.InProgress)
                                            {

                                          <text>bg-primary</text>
                                      }
                                            else
                                            {

                                                <text>bg-secondary</text>
                                            }
        ">
                                            @item.Status
                                        </span>
                                @if (activeTaskId == item.Id)
                                {
                                    <span id="timer-@item.Id" class="timer"></span>
                                }
                            </div>
                            <div class="d-flex justify-content-start mt-3">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm me-2" title="Edit">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                @if (activeWorkSessionId == null)
                                {
                                    if (item.Status == InternTracker.Models.TaskStatus.NotStarted)
                                    {
                                        <a asp-action="Start" asp-route-id="@item.Id" class="btn btn-success btn-sm me-2" title="Start Task">
                                            <i class="fas fa-play"></i> Start
                                        </a>
                                    }
                                }
                                else if (activeTaskId == item.Id)
                                {
                                    <a asp-action="Stop" asp-route-id="@item.Id" class="btn btn-danger btn-sm me-2" title="Stop Task">
                                        <i class="fas fa-stop"></i> Stop
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center" role="alert">
                    <h4 class="alert-heading">No Tasks Found!</h4>
                    <p>You currently have no assigned tasks. Your mentor will assign tasks here.</p>
                    <hr>
                    <a asp-action="LogWorkSession" class="btn btn-success fw-bold">
                        <i class="fas fa-clock me-2"></i>Log a Work Session
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            let timerInterval;
            let activeTaskId = @(activeTaskId ?? 0);

            function updateTimer(startTime, timerElement) {
                const start = new Date(startTime).getTime();
                timerInterval = setInterval(() => {
                    const now = new Date().getTime();
                    const distance = now - start;
                    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                    const seconds = Math.floor((distance % (1000 * 60)) / 1000);
                    timerElement.textContent = `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
                }, 1000);
            }

            if (activeTaskId > 0) {
                const startTime = localStorage.getItem(`startTime-${activeTaskId}`);
                if (startTime) {
                    const timerElement = document.getElementById(`timer-${activeTaskId}`);
                    if (timerElement) {
                        updateTimer(startTime, timerElement);
                    }
                }
            }

            document.querySelectorAll('.btn-success').forEach(button => {
                button.addEventListener('click', function(e) {
                    const taskId = this.href.split('/').pop();
                    localStorage.setItem(`startTime-${taskId}`, new Date().toISOString());
                });
            });

            document.querySelectorAll('.btn-danger').forEach(button => {
                button.addEventListener('click', function(e) {
                    const taskId = this.href.split('/').pop();
                    clearInterval(timerInterval);
                    localStorage.removeItem(`startTime-${taskId}`);
                });
            });
        });
    </script>
}