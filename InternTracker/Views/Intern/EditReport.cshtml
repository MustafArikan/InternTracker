@model InternTracker.Models.Report

@{
    ViewData["Title"] = "Edit Report";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h2 class="card-title text-center fw-bold mb-4">@ViewData["Title"]</h2>
                    <form asp-action="EditReport" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="form-floating mb-3">
                            <textarea asp-for="Feedback" class="form-control" placeholder="Your feedback or comments" style="height: 150px;"></textarea>
                            <label asp-for="Feedback">Your feedback or comments</label>
                            <span asp-validation-for="Feedback" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Current File</label>
                            <div>
                                <a href="@Model.FilePath" target="_blank">View Current Report</a>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="reportFile" class="form-label">Upload New File (Optional)</label>
                            <input type="file" id="reportFile" name="reportFile" class="form-control" />
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
                            <a asp-action="Reports" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}