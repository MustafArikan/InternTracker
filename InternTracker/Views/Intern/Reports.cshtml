@model IEnumerable<InternTracker.Models.Report>

@{
    ViewData["Title"] = "My Reports";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="display-5 fw-bold">@ViewData["Title"]</h1>
            <p class="text-muted">Submit your work and view feedback from your mentor.</p>
        </div>
        <div class="col-auto">
            <a asp-action="SubmitReport" class="btn btn-primary fw-bold">+ Submit Report</a>
        </div>
    </div>

    @foreach (var item in Model)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header">
                Report Submitted: @item.SubmissionDate.ToString("MMMM dd, yyyy")
            </div>
            <div class="card-body">
                <p class="card-text"><strong>Your Feedback:</strong> @item.Feedback</p>
                <p class="card-text"><strong>Mentor Feedback:</strong> @(item.MentorFeedback ?? "No feedback yet.")</p>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3 text-end">
                <a href="@item.FilePath" target="_blank" class="btn btn-secondary btn-sm">View File</a>
                <a asp-action="EditReport" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                <a asp-action="DeleteReport" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Delete</a>
            </div>
        </div>
    }
</div>