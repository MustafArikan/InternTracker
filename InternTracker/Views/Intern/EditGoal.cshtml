@model InternTracker.Models.Goal

@{
    ViewData["Title"] = "Edit Goal";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h2 class="card-title text-center fw-bold mb-4">@ViewData["Title"]</h2>
                    <form asp-action="EditGoal">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="CreatedDate" />

                        <div class="form-floating mb-3">
                            <input asp-for="GoalTitle" class="form-control" placeholder="Goal Title" />
                            <label asp-for="GoalTitle">Goal Title</label>
                            <span asp-validation-for="GoalTitle" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<GoalStatus>()"></select>
                            <label asp-for="Status">Status</label>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <textarea asp-for="ReflectionText" class="form-control" placeholder="Reflection" style="height: 120px;"></textarea>
                            <label asp-for="ReflectionText">Reflection</label>
                            <span asp-validation-for="ReflectionText" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
                            <a asp-action="Goals" class="btn btn-outline-dark">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}