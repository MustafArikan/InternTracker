@model InternTracker.Models.Goal

@{
    ViewData["Title"] = "Delete Goal";
}

<h2>Delete Goal</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Goal</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.GoalTitle)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.GoalTitle)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ReflectionText)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ReflectionText)
        </dd>
    </dl>
    
    <form asp-action="DeleteGoals">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Goals">Back to List</a>
