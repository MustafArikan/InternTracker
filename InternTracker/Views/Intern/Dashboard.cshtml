@model InternTracker.Models.InternDashboardViewModel

@{
    ViewData["Title"] = "Intern Dashboard";
}

<h1>Intern Dashboard for @Model.Intern.Username</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                Tasks Status
            </div>
            <div class="card-body">
                <canvas id="tasksStatusChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                Time Spent Weekly (Minutes)
            </div>
            <div class="card-body">
                <canvas id="timeSpentWeeklyChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                Goals Status
            </div>
            <div class="card-body">
                <canvas id="goalsStatusChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                Reports Submitted Weekly
            </div>
            <div class="card-body">
                <canvas id="reportsSubmittedChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Data from Model
        const tasksStatusLabels = @Html.Raw(Json.Serialize(Model.TaskStatusLabels));
        const tasksStatusCounts = @Html.Raw(Json.Serialize(Model.TaskStatusCounts));

        const timeSpentWeeklyLabels = @Html.Raw(Json.Serialize(Model.TimeSpentWeeklyLabels));
        const timeSpentWeeklyData = @Html.Raw(Json.Serialize(Model.TimeSpentWeeklyData));

        const goalStatusLabels = @Html.Raw(Json.Serialize(Model.GoalStatusLabels));
        const goalStatusCounts = @Html.Raw(Json.Serialize(Model.GoalStatusCounts));

        const reportsSubmittedLabels = @Html.Raw(Json.Serialize(Model.ReportsSubmittedLabels));
        const reportsSubmittedCounts = @Html.Raw(Json.Serialize(Model.ReportsSubmittedCounts));

        const chartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        };

        new Chart(
            document.getElementById('tasksStatusChart'),
            {
                type: 'bar',
                data: {
                    labels: tasksStatusLabels,
                    datasets: [{
                        label: 'Tasks Status',
                        data: tasksStatusCounts,
                        backgroundColor: 'rgba(75, 192, 192, 0.6)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 1
                    }]
                },
                options: chartOptions
            }
        );

        new Chart(
            document.getElementById('timeSpentWeeklyChart'),
            {
                type: 'line',
                data: {
                    labels: timeSpentWeeklyLabels,
                    datasets: [{
                        label: 'Time Spent (Minutes)',
                        data: timeSpentWeeklyData,
                        fill: false,
                        borderColor: 'rgb(75, 192, 192)',
                        tension: 0.1
                    }]
                },
                options: chartOptions
            }
        );

        new Chart(
            document.getElementById('goalsStatusChart'),
            {
                type: 'doughnut',
                data: {
                    labels: goalStatusLabels,
                    datasets: [{
                        label: 'Goals',
                        data: goalStatusCounts,
                        backgroundColor: [
                            'rgba(75, 192, 192, 0.6)',
                            'rgba(255, 206, 86, 0.6)',
                            'rgba(255, 99, 132, 0.6)'
                        ],
                        borderColor: [
                            'rgba(75, 192, 192, 1)',
                            'rgba(255, 206, 86, 1)',
                            'rgba(255, 99, 132, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: chartOptions
            }
        );

        new Chart(
            document.getElementById('reportsSubmittedChart'),
            {
                type: 'bar',
                data: {
                    labels: reportsSubmittedLabels,
                    datasets: [{
                        label: 'Reports Submitted',
                        data: reportsSubmittedCounts,
                        backgroundColor: 'rgba(153, 102, 255, 0.6)',
                        borderColor: 'rgba(153, 102, 255, 1)',
                        borderWidth: 1
                    }]
                },
                options: chartOptions
            }
        );
    </script>
}