@model InternTracker.Models.JournalEntry

@{
    ViewData["Title"] = "Delete Journal Entry";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body p-4">
                    <h5 class="card-title">Are you sure you want to delete this journal entry?</h5>
                    <p class="text-muted">This action cannot be undone.</p>
                    
                    <div class="alert alert-warning">
                        <p><strong>Date:</strong> @Model.Date.ToString("MMMM dd, yyyy")</p>
                        <p><strong>Entry:</strong> @Model.EntryText</p>
                    </div>

                    <form asp-action="DeleteJournalEntry">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-danger">Yes, Delete</button>
                            <a asp-action="JournalEntries" class="btn btn-secondary">No, Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>