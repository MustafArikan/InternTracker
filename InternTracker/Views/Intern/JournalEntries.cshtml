@model IEnumerable<InternTracker.Models.JournalEntry>

@{
    ViewData["Title"] = "My Journal";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .stat-card {
            border-left: 5px solid var(--bs-primary);
            transition: all 0.2s ease-in-out;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                border-left-width: 7px;
            }

        .nav-card {
            text-decoration: none;
            color: inherit;
            display: block;
            transition: all 0.3s ease-in-out;
        }

            .nav-card:hover {
                transform: scale(1.03);
                box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
            }

            .nav-card .card-body {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 150px;
            }

        .nav-card-icon {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            color: var(--bs-primary);
        }
    </style>
}

<div class="container py-5">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="display-5 fw-bold">@ViewData["Title"]</h1>
            <p class="text-muted">A space for your thoughts, learnings, and reflections.</p>
        </div>
        <div class="col-auto">
            <a asp-action="CreateJournalEntry" class="btn btn-primary fw-bold">
                <i class="fas fa-plus-circle me-2"></i>New Entry
            </a>
        </div>
    </div>

    <div class="row">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm nav-card">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-book-open fa-2x text-primary me-3"></i>
                                <div>
                                    <h5 class="card-title mb-0">@item.Date.ToString("MMMM dd, yyyy")</h5>
                                    <small class="text-muted">@item.EntryText</small>
                                </div>
                            </div>
                            <div class="mt-auto d-flex justify-content-start">
                                <a asp-action="EditJournalEntry" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm me-2">
                                    <i class="fas fa-edit me-1"></i> Edit
                                </a>
                                <a asp-action="DeleteJournalEntry" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm"
                                   onclick="return confirm('Are you sure you want to delete this journal entry?');">
                                    <i class="fas fa-trash-alt me-1"></i> Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center" role="alert">
                    <h4 class="alert-heading">No Journal Entries Found!</h4>
                    <p>You haven't made any journal entries yet. Create your first entry to get started.</p>
                    <hr>
                    <a asp-action="CreateJournalEntry" class="btn btn-success fw-bold">
                        <i class="fas fa-plus-circle me-2"></i>Create Your First Entry
                    </a>
                </div>
            </div>
        }
    </div>
</div>