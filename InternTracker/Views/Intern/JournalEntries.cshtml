@model IEnumerable<InternTracker.Models.JournalEntry>

@{
    ViewData["Title"] = "My Journal";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="display-5 fw-bold">@ViewData["Title"]</h1>
            <p class="text-muted">A space for your thoughts, learnings, and reflections.</p>
        </div>
        <div class="col-auto">
            <a asp-action="CreateJournalEntry" class="btn btn-primary fw-bold">+ New Entry</a>
        </div>
    </div>

    @foreach (var item in Model)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h5 class="card-title">@item.Date.ToString("MMMM dd, yyyy")</h5>
                <p class="card-text">@item.EntryText</p>
                <div class="text-end">
                    <a asp-action="EditJournalEntry" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                    <a asp-action="DeleteJournalEntry" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                </div>
            </div>
        </div>
    }
</div>