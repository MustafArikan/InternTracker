@model InternTracker.Models.JournalEntry

@{
    ViewData["Title"] = "Create Journal Entry";
}

<h2>Create Journal Entry</h2>

<h4>JournalEntry</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="CreateJournalEntry">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="EntryText" class="control-label"></label>
                <textarea asp-for="EntryText" class="form-control"></textarea>
                <span asp-validation-for="EntryText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="JournalEntries">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
