@model InternTracker.Models.JournalEntry

@{
    ViewData["Title"] = "Create Journal Entry";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h2 class="card-title text-center fw-bold mb-4">@ViewData["Title"]</h2>
                    <form asp-action="CreateJournalEntry">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="form-floating mb-3">
                            <textarea asp-for="EntryText" class="form-control" placeholder="What's on your mind?" style="height: 200px;"></textarea>
                            <label asp-for="EntryText">What's on your mind?</label>
                            <span asp-validation-for="EntryText" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Save Entry</button>
                            <a asp-action="JournalEntries" class="btn btn-outline-dark">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}