@model InternTracker.Models.Report

@{
    ViewData["Title"] = "Delete Report";
}

<h2>Delete Report</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Report</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SubmissionDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SubmissionDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Feedback)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Feedback)
        </dd>
        <dt class = "col-sm-2">
            File
        </dt>
        <dd class = "col-sm-10">
            <a href="@Model.FilePath" target="_blank">View Report</a>
        </dd>
    </dl>
    
    <form asp-action="DeleteReport">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Reports">Back to List</a>
    </form>
</div>
