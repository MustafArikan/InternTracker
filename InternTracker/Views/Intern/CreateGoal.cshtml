@model InternTracker.Models.Goal

@{
    ViewData["Title"] = "Create a New Goal";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h2 class="card-title text-center fw-bold mb-4">@ViewData["Title"]</h2>
                    <form asp-action="CreateGoal">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="form-floating mb-3">
                            <input asp-for="GoalTitle" class="form-control" placeholder="What is your goal?" />
                            <label asp-for="GoalTitle">What is your goal?</label>
                            <span asp-validation-for="GoalTitle" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Create Goal</button>
                            <a asp-action="Goals" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}