@model InternTracker.Models.Goal

@{
    ViewData["Title"] = "Create Goal";
}

<h2>Create Goal</h2>

<h4>Goal</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="CreateGoal">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="GoalTitle" class="control-label"></label>
                <input asp-for="GoalTitle" class="form-control" />
                <span asp-validation-for="GoalTitle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Goals">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
