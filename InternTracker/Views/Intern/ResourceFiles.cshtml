@model IEnumerable<InternTracker.Models.ResourceFile>

@{
    ViewData["Title"] = "Resource Files";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5 fw-bold">@ViewData["Title"]</h1>
            <p class="text-muted">Helpful documents and links provided by your mentors.</p>
        </div>
    </div>

    <div class="list-group">
        @foreach (var item in Model)
        {
            <a href="@item.FilePath" target="_blank" download class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">@item.Title</h5>
                    <small>Uploaded on @item.UploadDate.ToString("MMM dd, yyyy") by @item.UploadedByUser.Role</small>
                </div>
                <i class="fas fa-download"></i>
            </a>
        }
    </div>
</div>