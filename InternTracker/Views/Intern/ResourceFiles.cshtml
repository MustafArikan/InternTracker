@model IEnumerable<InternTracker.Models.ResourceFile>

@{
    ViewData["Title"] = "Resource Files";
    Layout = "_Layout";
}
@section Styles {
    <style>
        .stat-card {
            border-left: 5px solid var(--bs-primary);
            transition: all 0.2s ease-in-out;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                border-left-width: 7px;
            }

        .nav-card {
            text-decoration: none;
            color: inherit;
            display: block;
            transition: all 0.3s ease-in-out;
        }

            .nav-card:hover {
                transform: scale(1.03);
                box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
            }

            .nav-card .card-body {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 150px;
            }

        .nav-card-icon {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            color: var(--bs-primary);
        }
    </style>
}
<div class="container py-5">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5 fw-bold">@ViewData["Title"]</h1>
            <p class="text-muted">Helpful documents and links provided by your mentors.</p>
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm nav-card">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center mb-3">
                            <i class="fas fa-file-alt fa-2x text-primary me-3"></i>
                            <div>
                                <h5 class="card-title mb-0">@item.Title</h5>
                                <small class="text-muted">Uploaded on @item.UploadDate.ToString("MMM dd, yyyy") by @item.UploadedByUser.Role</small>
                            </div>
                        </div>
                        <div class="mt-auto">
                            <a href="@item.FilePath" target="_blank" download class="btn btn-outline-primary btn-sm me-2">
                                <i class="fas fa-download me-1"></i> Download
                            </a>
                            <a href="@item.FilePath" target="_blank" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-external-link-alt me-1"></i> Open
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>