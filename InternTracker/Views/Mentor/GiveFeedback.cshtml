@model InternTracker.Models.Report

@{
    ViewData["Title"] = "Give Feedback";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h2 class="card-title text-center fw-bold mb-4">Give Feedback for @Model.User.Username's Report</h2>
                    
                    <div class="mb-4">
                        <p class="mb-1"><strong>Submitted By:</strong> @Model.User.Username</p>
                        <p class="mb-1"><strong>Submission Date:</strong> @Model.SubmissionDate.ToString("MMMM dd, yyyy")</p>
                        <p class="mb-1"><strong>Intern's Feedback:</strong> @Model.Feedback</p>
                        <p class="mb-1">
                            <strong>Report File:</strong> 
                            <a href="@Model.FilePath" target="_blank" download class="btn btn-sm btn-outline-secondary ms-2">Download Report</a>
                        </p>
                    </div>

                    <form asp-action="GiveFeedback">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="form-floating mb-3">
                            <textarea name="mentorFeedback" class="form-control" placeholder="Your feedback" style="height: 150px;">@Model.MentorFeedback</textarea>
                            <label for="mentorFeedback">Mentor Feedback</label>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Save Feedback</button>
                            <a asp-action="ViewInternDetails" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">Back to Intern Details</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>