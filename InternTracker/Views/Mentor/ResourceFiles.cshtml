@model IEnumerable<InternTracker.Models.ResourceFile>

@{
    ViewData["Title"] = "Resource Files";
}

<h1>Resource Files</h1>

<p>
    <a asp-action="UploadResourceFile">Upload New Resource</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FilePath)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UploadDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UploadedByUser.Username)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                <a href="@item.FilePath" target="_blank">Download File</a>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UploadDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UploadedByUser.Username)
            </td>
            <td>
                @if (item.UploadedByUserId.ToString() == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                {
                    <a asp-action="EditResourceFile" asp-route-id="@item.Id">Edit</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
