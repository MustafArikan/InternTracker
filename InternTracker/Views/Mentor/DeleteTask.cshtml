@model InternTracker.Models.TaskItem

@{
    ViewData["Title"] = "Delete Task";
}

<h1>Delete Task</h1>
<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Task Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Title)</dd>

        <dt class="col-sm-2">Assigned To</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.AssignedToUser.Username)</dd>
    </dl>

    <form asp-action="DeleteTask">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="ViewInternDetails" asp-route-id="@Model.AssignedToUserId">Back to Intern Details</a>
    </form>
</div>