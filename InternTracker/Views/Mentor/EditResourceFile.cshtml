@model InternTracker.Models.ResourceFile

@{
    ViewData["Title"] = "Edit Resource File";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h2 class="card-title text-center fw-bold mb-4">@ViewData["Title"]</h2>
                    <form asp-action="EditResourceFile">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="FilePath" />
                        <input type="hidden" asp-for="UploadDate" />
                        <input type="hidden" asp-for="UploadedByUserId" />

                        <div class="form-floating mb-3">
                            <input asp-for="Title" class="form-control" placeholder="Resource Title" />
                            <label asp-for="Title">Resource Title</label>
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Current File</label>
                            <p><a href="@Model.FilePath" target="_blank" download class="btn btn-sm btn-outline-dark">Download Current File</a></p>
                            <small class="text-muted"><i>File content cannot be edited. To change the file, please upload a new resource.</i></small>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
                            <a asp-action="ResourceFiles" class="btn btn-outline-dark">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}