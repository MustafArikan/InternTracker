@model IEnumerable<AppUser>

@{
    ViewData["Title"] = "Mentor Dashboard";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .stat-card {
            border-left: 5px solid var(--bs-primary);
            transition: all 0.2s ease-in-out;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                border-left-width: 7px;
            }

        .nav-card {
            text-decoration: none;
            color: inherit;
            display: block;
            transition: all 0.3s ease-in-out;
        }

            .nav-card:hover {
                transform: scale(1.03);
                box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
            }

            .nav-card .card-body {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 150px;
            }

        .nav-card-icon {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            color: var(--bs-primary);
        }
        .profile-picture-thumb {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 15px;
            border: 2px solid #ddd;
        }
    </style>
}

<div class="container py-5">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="display-5 fw-bold">@ViewData["Title"]</h1>
            <p class="text-muted">Oversee and manage your assigned interns.</p>
        </div>
    </div>

    <div class="row">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm nav-card">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <img src="@(string.IsNullOrEmpty(item.ProfilePicturePath) ? "/images/default-avatar.png" : item.ProfilePicturePath)" class="profile-picture-thumb" alt="Profile Picture" />
                                <div>
                                    <h5 class="card-title mb-0">@item.Username</h5>
                                    <small class="text-muted">@item.Email</small>
                                </div>
                            </div>
                            <div class="mt-auto d-flex justify-content-start">
                                <a asp-action="ViewInternDetails" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm me-2">
                                    <i class="fas fa-info-circle me-1"></i> Details
                                </a>
                                <a asp-action="AssignTask" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm me-2">
                                    <i class="fas fa-plus-circle me-1"></i> Assign Task
                                </a>
                                <a asp-action="InternProgressDashboard" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                    <i class="fas fa-chart-line me-1"></i> Progress
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center" role="alert">
                    <h4 class="alert-heading">No Interns Found!</h4>
                    <p>There are currently no interns assigned to you.</p>
                </div>
            </div>
        }
    </div>
</div>