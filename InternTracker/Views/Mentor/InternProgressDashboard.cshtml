@model InternTracker.Models.InternProgressDashboardViewModel

@{
    ViewData["Title"] = $"{Model.Intern.Username}'s Progress Dashboard";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5 fw-bold">@ViewData["Title"]</h1>
            <p class="text-muted">Detailed insights into @Model.Intern.Username's internship progress.</p>
        </div>
    </div>

    <!-- Intern Details Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">Intern Details</div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-auto">
                    <img src="@(string.IsNullOrWhiteSpace(Model.Intern.ProfilePicturePath) ? Url.Content("~/images/default-avatar.png") : Url.Content(Model.Intern.ProfilePicturePath))"
                         alt="Profile Picture"
                         class="rounded-circle me-3"
                         style="width: 80px; height: 80px; object-fit: cover;" />
                </div>
                <div class="col">
                    <h5 class="mb-1">@Model.Intern.Username</h5>
                    <p class="mb-1 text-muted">@Model.Intern.Email</p>
                    <p class="mb-0 text-muted">Role: @Model.Intern.Role</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">Task Status</div>
                <div class="card-body d-flex justify-content-center align-items-center">
                    <canvas id="taskStatusChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">Goal Status</div>
                <div class="card-body d-flex justify-content-center align-items-center">
                    <canvas id="goalStatusChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">Work Session Log (Minutes)</div>
                <div class="card-body">
                    <canvas id="workSessionChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">Journal Entry Frequency</div>
                <div class="card-body">
                    <canvas id="journalEntryChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">Report Submission Trend</div>
                <div class="card-body">
                    <canvas id="reportSubmissionChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">Individual Work Sessions</div>
                <div class="card-body">
                    <canvas id="individualWorkSessionChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Activity Log Section -->
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">Activity Log</div>
        <div class="card-body">
            @if (Model.ActivityLogs.Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var log in Model.ActivityLogs)
                    {
                        <li class="list-group-item">@log</li>
                    }
                </ul>
            }
            else
            {
                <div class="alert alert-info mb-0">No recent activity for this intern.</div>
            }
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-outline-dark">Back to Intern List</a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Task Status Chart
            var ctxTaskStatus = document.getElementById('taskStatusChart').getContext('2d');
            new Chart(ctxTaskStatus, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.TaskStatusLabels)),
                    datasets: [{
                        data: @Html.Raw(Json.Serialize(Model.TaskStatusCounts)),
                        backgroundColor: [
                            'rgba(255, 99, 132, 0.7)', // Not Started
                            'rgba(54, 162, 235, 0.7)', // In Progress
                            'rgba(75, 192, 192, 0.7)'  // Completed
                        ],
                        borderColor: [
                            'rgba(255, 99, 132, 1)',
                            'rgba(54, 162, 235, 1)',
                            'rgba(75, 192, 192, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        title: { display: false }
                    }
                }
            });

            // Goal Status Chart
            var ctxGoalStatus = document.getElementById('goalStatusChart').getContext('2d');
            new Chart(ctxGoalStatus, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.GoalStatusLabels)),
                    datasets: [{
                        data: @Html.Raw(Json.Serialize(Model.GoalStatusCounts)),
                        backgroundColor: [
                            'rgba(75, 192, 192, 0.7)', // Active
                            'rgba(255, 206, 86, 0.7)', // Completed
                            'rgba(255, 99, 132, 0.7)'  // Archived
                        ],
                        borderColor: [
                            'rgba(75, 192, 192, 1)',
                            'rgba(255, 206, 86, 1)',
                            'rgba(255, 99, 132, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        title: { display: false }
                    }
                }
            });

            // Work Session Log Chart
            var ctxWorkSession = document.getElementById('workSessionChart').getContext('2d');
            new Chart(ctxWorkSession, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.WorkSessionDates)),
                    datasets: [{
                        label: 'Minutes Logged',
                        data: @Html.Raw(Json.Serialize(Model.WorkSessionMinutes)),
                        backgroundColor: 'rgba(153, 102, 255, 0.7)',
                        borderColor: 'rgba(153, 102, 255, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        title: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });

            // Journal Entry Frequency Chart
            var ctxJournalEntry = document.getElementById('journalEntryChart').getContext('2d');
            new Chart(ctxJournalEntry, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.JournalEntryDates)),
                    datasets: [{
                        label: 'Entries Count',
                        data: @Html.Raw(Json.Serialize(Model.JournalEntryCounts)),
                        backgroundColor: 'rgba(255, 159, 64, 0.7)',
                        borderColor: 'rgba(255, 159, 64, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        title: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });

            // Report Submission Trend Chart
            var ctxReportSubmission = document.getElementById('reportSubmissionChart').getContext('2d');
            new Chart(ctxReportSubmission, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.ReportSubmissionDates)),
                    datasets: [{
                        label: 'Reports Submitted',
                        data: @Html.Raw(Json.Serialize(Model.ReportSubmissionCounts)),
                        borderColor: 'rgba(54, 162, 235, 1)',
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        fill: true,
                        tension: 0.1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        title: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });

            // Individual Work Sessions Chart
            var ctxIndividualWorkSession = document.getElementById('individualWorkSessionChart').getContext('2d');
            new Chart(ctxIndividualWorkSession, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.IndividualWorkSessionLabels)),
                    datasets: [{
                        label: 'Minutes Logged',
                        data: @Html.Raw(Json.Serialize(Model.IndividualWorkSessionMinutes)),
                        backgroundColor: 'rgba(75, 192, 192, 0.7)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        title: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });
        });
    </script>
}
