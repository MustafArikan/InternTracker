@model InternTracker.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register as Admin";
    Layout = "_Layout";
}

<div class="container-fluid d-flex align-items-center justify-content-center py-5 bg-body" style="min-height: 10vh;">
    <div class="card shadow-lg rounded-4 border-0" style="max-width: 600px; width: 100%; overflow: hidden;">
        <div class="card-body p-4 p-md-5">

            <h2 class="fw-bold mb-2">@ViewData["Title"]</h2>
            <h5 class="fw-normal text-muted mb-4">Create an administrator account.</h5>

            <form asp-action="RegisterAdmin" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Username" class="form-control" id="floatingUsername" placeholder="Choose a username" />
                    <label asp-for="Username" for="floatingUsername"></label>
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Email" type="email" class="form-control" id="floatingEmail" placeholder="name@example.com" />
                    <label asp-for="Email" for="floatingEmail"></label>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="Create a password" />
                    <label asp-for="Password" for="floatingPassword"></label>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="ConfirmPassword" type="password" class="form-control" id="floatingConfirmPassword" placeholder="Confirm your password" />
                    <label asp-for="ConfirmPassword" for="floatingConfirmPassword"></label>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="d-grid mb-4">
                    <button class="btn btn-primary btn-lg fw-bold" type="submit">Register Admin</button>
                </div>

                <div class="text-center">
                    <p class="mb-0">
                        Already have an account? <a asp-action="Login" class="fw-bold">Login</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}