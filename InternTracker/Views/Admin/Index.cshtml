@model IEnumerable<AppUser>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="mb-0">
            <i class="fas fa-users-cog me-2"></i>@ViewData["Title"]
        </h2>
        <a asp-action="CreateUser" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Create New User
        </a>
    </div>

    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Username)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Email)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Role)
                            </th>
                            <th style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="d-flex align-items-center">
                                    <img src="@(item.ProfilePicturePath ?? Url.Content("~/images/default-avatar.png"))"
                                         alt="Profile Picture"
                                         class="me-3" 
                                         style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;" />
                                    <span>@Html.DisplayFor(modelItem => item.Username)</span>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Email)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Role)
                                </td>
                                <td>
                                    <a asp-action="EditUser" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit @item.Username">
                                        <i class="fas fa-pencil-alt"></i> Edit
                                    </a>
                                    <a asp-action="DeleteUser" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete @item.Username"
                                       onclick="return confirm('Are you sure you want to delete the user: @item.Username?');">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                <h4 class="alert-heading">No Users Found!</h4>
                <p>There are currently no users in the system. You can get started by creating one.</p>
                <hr>
                <p class="mb-0">
                    <a asp-action="CreateUser" class="btn btn-success">
                        <i class="fas fa-plus me-1"></i> Create the First User
                    </a>
                </p>
            </div>
        }
    </div>
</div>