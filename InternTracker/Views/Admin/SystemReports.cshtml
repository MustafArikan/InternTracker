@model InternTracker.Models.SystemReportsViewModel

@{
    ViewData["Title"] = "System Reports";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5 fw-bold">@ViewData["Title"]</h1>
            <p class="text-muted">Comprehensive reports on user activity and system usage.</p>
        </div>
    </div>

    <!-- User Statistics and Role Distribution -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">User Statistics</div>
                <div class="card-body">
                    <table class="table table-striped table-borderless">
                        <tbody>
                            <tr><td>Total Users</td><td class="text-end">@Model.TotalUsers</td></tr>
                            <tr><td>Total Interns</td><td class="text-end">@Model.TotalInterns</td></tr>
                            <tr><td>Total Mentors</td><td class="text-end">@Model.TotalMentors</td></tr>
                            <tr><td>Total Admins</td><td class="text-end">@Model.TotalAdmins</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">User Role Distribution</div>
                <div class="card-body d-flex justify-content-center align-items-center">
                    <canvas id="userRoleChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Resource Uploads by Role -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">Resource Uploads by Role</div>
                <div class="card-body">
                    <table class="table table-striped table-borderless">
                        <tbody>
                            <tr><td>Mentor Uploads</td><td class="text-end">@Model.TotalMentorUploads</td></tr>
                            <tr><td>Admin Uploads</td><td class="text-end">@Model.TotalAdminUploads</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">Resource Uploads Chart</div>
                <div class="card-body d-flex justify-content-center align-items-center">
                    <canvas id="resourceUploadHorizontalChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- User Registration Trend -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header fw-bold d-flex justify-content-between align-items-center">
                    User Registration Trend
                    <form asp-action="SystemReports" method="get" class="d-flex">
                        <label for="startDate" class="col-form-label me-2">Filter from:</label>
                        <input type="date" id="startDate" name="startDate" class="form-control form-control-sm" value="@(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd") : "")" onchange="this.form.submit()" />
                    </form>
                </div>
                <div class="card-body">
                    <canvas id="userRegistrationChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-outline-dark">Back to User Management</a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // User Role Distribution Chart
            var ctxUserRole = document.getElementById('userRoleChart').getContext('2d');
            new Chart(ctxUserRole, {
                type: 'pie',
                data: {
                    labels: ['Total Users', 'Total Interns', 'Total Mentors', 'Total Admins'],
                    datasets: [{
                        label: '# of Users',
                        data: [@Model.TotalUsers, @Model.TotalInterns, @Model.TotalMentors, @Model.TotalAdmins],
                        backgroundColor: [
                            'rgba(255, 99, 132, 0.7)',
                            'rgba(54, 162, 235, 0.7)',
                            'rgba(255, 206, 86, 0.7)',
                            'rgba(75, 192, 192, 0.7)'
                        ],
                        borderColor: [
                            'rgba(255, 99, 132, 1)',
                            'rgba(54, 162, 235, 1)',
                            'rgba(255, 206, 86, 1)',
                            'rgba(75, 192, 192, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        title: { display: false }
                    }
                }
            });

            // Resource Uploads by Role Chart
            var ctxResourceUploadHorizontal = document.getElementById('resourceUploadHorizontalChart').getContext('2d');
            new Chart(ctxResourceUploadHorizontal, {
                type: 'bar',
                data: {
                    labels: ['Mentor Uploads', 'Admin Uploads'],
                    datasets: [{
                        label: 'Number of Uploads',
                        data: [@Model.TotalMentorUploads, @Model.TotalAdminUploads],
                        backgroundColor: [
                            'rgba(153, 102, 255, 0.7)',
                            'rgba(255, 159, 64, 0.7)'
                        ],
                        borderColor: [
                            'rgba(153, 102, 255, 1)',
                            'rgba(255, 159, 64, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        title: { display: false }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });

            // User Registration Trend Chart
            var ctxUserRegistration = document.getElementById('userRegistrationChart').getContext('2d');
            new Chart(ctxUserRegistration, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.RegistrationDates)),
                    datasets: [{
                        label: 'New Registrations',
                        data: @Html.Raw(Json.Serialize(Model.RegistrationCounts)),
                        borderColor: 'rgba(75, 192, 192, 1)',
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        fill: true,
                        tension: 0.1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        title: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });
        });
    </script>
}